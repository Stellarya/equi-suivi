{# left sidebar #}
{% macro navItem(icon, label, role, link, params = {}, idItem = null) %}
	{% if is_granted(role) %}
		<div class="nav-item" data-value="{{ label }}" {% if idItem is not null %} id="{{ idItem }}" {% endif %}>
			<a {% if link is not null %} href="{{ path(link, params) }}" {% if app.request.attributes.get('_route') == link %} aria-current="page" {% endif %} {% endif %}>
				<i class="{{ icon }}" aria-hidden="true"></i>
				<span>{{ label | trans }}</span>
			</a>
		</div>
	{% endif %}
{% endmacro %}

{# Tabs génériques Bootstrap-like #}
{% macro navItemTabs(icon, label, link, active = false) %}
	<li class="nav-item text-truncate" role="presentation">
		<a class="nav-link {% if active %}active{% endif %} text-truncate" role="tab" id="tab-{{ link }}" href="#{{ link }}" aria-controls="{{ link }}" aria-selected="{{ active ? 'true' : 'false' }}" data-toggle="tab">
			<i class="{{ icon }}" aria-hidden="true"></i>
			<span class="d-none d-lg-inline text-truncate">{{ label | trans }}</span>
			<span class="visually-hidden d-lg-none">{{ label | trans }}</span>
		</a>
	</li>
{% endmacro %}

{# Tabs profil/details #}
{% macro tab(icon, label, target, isActive = false) %}
	<button type="button" role="tab" id="tab-{{ target }}" class="details-tabs__item{% if isActive %} details-tabs__item--active{% endif %}" aria-selected="{{ isActive ? 'true' : 'false' }}" aria-controls="{{ target }}" tabindex="{{ isActive ? '0' : '-1' }}" data-target="{{ target }}" data-tab="{{ target }}">
		<i class="{{ icon }}" aria-hidden="true"></i>
		<span>{{ label|trans }}</span>
	</button>
{% endmacro %}

{# Buttons #}
{% macro addButton(id, label = 'actions.add', class = 'btn btn-primary') %}
	<button type="button" class="{{ class }}" id="{{ id }}">
		<i class="fa-solid fa-plus" aria-hidden="true"></i>
		<span>{{ label | trans }}</span>
	</button>
{% endmacro %}

{% macro actionLink(href, label, icon, class = '') %}
	<a href="{{ href }}" class="{{ class }}">
		<span>{{ label | trans }}</span>
		<i class="{{ icon }}" aria-hidden="true"></i>
	</a>
{% endmacro %}

{% macro deleteButton(id, label = 'actions.delete', class = 'btn btn-danger') %}
	<button type="button" id="{{ id }}" class="{{ class }}" data-value="{{ id }}" aria-label="{{ label | trans }}">
		<i class="fa-solid fa-trash" aria-hidden="true"></i>
	</button>
{% endmacro %}

{% macro updateButton(id, label = 'actions.edit', class = '') %}
	<button type="button" id="{{ id }}" class="{{ class }}" data-value="{{ id }}" aria-label="{{ label | trans }}">
		<i class="fa-solid fa-pencil" aria-hidden="true"></i>
	</button>
{% endmacro %}

{% macro modalButton(id, label, icon, modalTarget, class = '', showLabel = false) %}
	<button type="button" id="{{ id }}" class="{{ class }}" aria-label="{{ label | trans }}" aria-haspopup="dialog" data-modal-open="{{ modalTarget }}">
		{% if showLabel %}
			<span>{{ label | trans }}</span>
		{% endif %}
		<i class="{{ icon }}" aria-hidden="true"></i>
	</button>
{% endmacro %}
