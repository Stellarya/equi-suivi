{% extends 'base_public.html.twig' %}

{% block title %}
	{{ 'general.login.title'|trans }}
	—
	{{ 'general.equi_suivi' | trans }}
{% endblock %}

{% block body %}
	<div class="login">
		<div class="img-side" style="background-image: url('{{ asset('images/login-1.jpg') }}')"></div>

		<div class="text-side">
			<div class="box">
				<form
					method="post">
					{# role="alert" : le message doit être porté à la connaissance de
										   l'utilisateur, pas seulement affiché en rouge. #}
					{% if error %}
						<div class="alert alert-danger" role="alert">
							<span class="visually-hidden">{{ 'general.login.error_title'|trans }}
								:</span>
							{{ error.messageKey|trans(error.messageData, 'security') }}
						</div>
					{% endif %}

					{% if app.user %}
						<div class="mb-3">
							{{ 'general.login.already_logged_in'|trans({'%identifier%': app.user.userIdentifier}) }}
							<a href="{{ logout_path() }}">{{ 'general.topbar.logout'|trans }}</a>
						</div>
					{% endif %}

					<h1>{{ 'general.login.title'|trans }}</h1>
					<p class="subtitle">{{ 'general.login.subtitle'|trans }}</p>

					<div class="form-group">
						<label for="inputEmail">{{ 'general.login.email'|trans }}</label>
						<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
					</div>

					<div class="form-group">
						<label for="inputPassword">{{ 'general.login.password'|trans }}</label>
						<input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
					</div>

					<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

					<button class="btn btn-primary login-button" type="submit">
						{{ 'general.login.connection_button'|trans }}
					</button>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
