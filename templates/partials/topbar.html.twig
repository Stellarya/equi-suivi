{% set roleLabel = null %}
{% set rider = null %}
{% set notificationCount = 6 %}

{% if app.user %}
	{% if is_granted('ROLE_ADMIN') %}
		{% set roleLabel = 'general.roles.admin'|trans %}
	{% elseif is_granted('ROLE_ECURIE') %}
		{% set roleLabel = 'general.roles.ranch'|trans %}
	{% elseif is_granted('ROLE_USER') %}
		{% set roleLabel = 'general.roles.rider'|trans %}
	{% endif %}

	{% set rider = app.user.rider ?? null %}
{% endif %}

<header class="topbar">
	<div class="topbar__actions">
		{% if app.user %}
			{# Le compteur est une information visuelle : sans lui dans le nom
						   accessible, un lecteur d'écran annonce seulement « Notifications ». #}
			<button class="topbar__notification" type="button" aria-label="{{ 'general.notifications_unread'|trans({'%count%': notificationCount}) }}">
				<i class="fa-solid fa-bell" aria-hidden="true"></i>
				<span class="topbar__notification-badge" aria-hidden="true">{{ notificationCount }}</span>
			</button>

			<div class="topbar__profile-wrapper" data-dropdown="user-menu">
				<button class="topbar__profile" type="button" aria-label="{{ 'general.user_menu'|trans }}" aria-expanded="false" aria-controls="topbar-user-menu" data-dropdown-trigger>
					<span class="topbar__avatar">
						<i class="fa-solid fa-user" aria-hidden="true"></i>
					</span>

					<span class="topbar__identity">
						<span class="topbar__name">
							{% if rider %}
								{{ rider.fullName }}
							{% else %}
								{{ app.user.email }}
							{% endif %}
						</span>

						<span class="topbar__role">
							{{ roleLabel }}
						</span>
					</span>

					<i class="fa-solid fa-chevron-down topbar__chevron" aria-hidden="true"></i>
				</button>

				<div id="topbar-user-menu" class="topbar__dropdown" data-dropdown-menu>
					<a href="{{ path('app_rider_profile') }}" class="topbar__dropdown-link">
						<i class="fa-solid fa-id-card" aria-hidden="true"></i>
						<span>{{ 'general.topbar.profile' | trans }}</span>
					</a>

					<a href="{{ path('app_logout') }}" class="topbar__dropdown-link topbar__dropdown-link--danger">
						<i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
						<span>{{ 'general.topbar.logout' | trans }}</span>
					</a>
				</div>
			</div>
		{% endif %}
	</div>
</header>
